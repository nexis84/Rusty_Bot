# EVE SSO credentials — required for /api/token-exchange endpoint
# Get these from https://developers.eveonline.com/
EVE_CLIENT_ID="your_client_id_here"
EVE_CLIENT_SECRET="your_client_secret_here"

# PI Visualizer EVE SSO app — required for /api/pi/token-exchange endpoint
EVE_PI_CLIENT_ID="your_pi_client_id_here"
EVE_PI_CLIENT_SECRET="your_pi_client_secret_here"

# Rusty Routes EVE SSO app — required for /api/auth/rr/* and /api/waypoints/push
# Create a separate app at https://developers.eveonline.com/ and register the
# callback URL https://www.rustybot.co.uk/Rusty%20Routes/auth-callback.html
# with scope esi-ui.write_waypoint.v1 (plus any others you want).
EVE_RR_CLIENT_ID="your_rr_client_id_here"
EVE_RR_CLIENT_SECRET="your_rr_client_secret_here"
# Optional override; defaults to the dev-portal-registered URL.
# EVE_RR_CALLBACK_URL="https://www.rustybot.co.uk/Rusty%20Routes/auth-callback.html"

# Rusty Routes preview access gate. When set, the planner requires ?access=KEY
# (or a rr_access cookie). Leave unset to keep the page open.
# RR_ACCESS_KEY="change-me-preview-key"

# Server port (defaults to 8080)
PORT=8080

# Optional: base URL path prefix (e.g. /rustybot)
# BASE_URL=/rustybot

# Rusty Stats reads from Rusty_DrawBot.csv — no API credentials needed
