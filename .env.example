# EVE SSO credentials — required for /api/token-exchange endpoint
# Get these from https://developers.eveonline.com/
EVE_CLIENT_ID="your_client_id_here"
EVE_CLIENT_SECRET="your_client_secret_here"

# Server port (defaults to 8080)
PORT=8080

# Optional: base URL path prefix (e.g. /rustybot)
# BASE_URL=/rustybot

# Supabase credentials — required for the SKINR Gallery feature
# Get these from https://supabase.com/dashboard/project/<your-project>/settings/api
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Admin characters for SKINR Gallery (comma-separated EVE character IDs)
# ADMIN_CHARACTER_IDS="108115856"

# Rusty Stats reads from Rusty_DrawBot.csv — no API credentials needed
